{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pompom",
      "type": "debugpy",
      "request": "launch",
      "module": "pompom",
      "cwd": "${workspaceFolder}/..",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/../.venv/Scripts/python.exe",
      "pythonArgs": ["-Xfrozen_modules=off"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/.."
      },
      "subProcess": false,
      "justMyCode": true
    },
    {
      "name": "pompom (run, no debugger)",
      "type": "node-terminal",
      "request": "launch",
      "command": "\"${workspaceFolder}/../.venv/Scripts/python.exe\" -m pompom",
      "cwd": "${workspaceFolder}/.."
    }
  ]
}
